# Secrets et données personnelles : jamais dans une image (les identifiants arrivent à l'exécution, par `env_file`).
app/.env
app/.env.local
app/.env.*.local
app/config/profile/local/*
app/var/*
app/vendor/*
app/node_modules
app/.phpunit.cache
app/tests

# Définition de l'infrastructure : inutile dans le contexte de build (sauf ce que les Dockerfile copient).
docker-compose*.yml
traefik/
certs/
docker/*
!docker/php
!docker/nginx
!docker/cron
