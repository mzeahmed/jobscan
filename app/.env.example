###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_with_a_random_32_char_string
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite (défaut — aucune installation requise)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/jobscan.db"

# PostgreSQL (optionnel)
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/jobscan?serverVersion=16&charset=utf8"

# MySQL / MariaDB (optionnel)
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/jobscan?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> searxng ###
# Instance SearXNG locale (Docker recommandé)
# docker run -d -p 8080:8080 searxng/searxng
SEARXNG_URL='https://searxng.local:8443/'
###< searxng ###

###> ai-provider ###
# Le moteur LLM actif. Surchargez cette valeur dans .env.local si nécessaire.
# ollama | lmstudio | gemini
DEFAULT_LLM_PROVIDER=ollama

# ── Ollama (recommandé) ──
# Installation : https://ollama.com
#   ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Si Symfony tourne dans Docker et Ollama sur l'hôte :
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ── Legacy provider : LM Studio (conservé pour compatibilité, non recommandé) ──
# Démarrer LM Studio → charger un modèle → activer le serveur local (port 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# ── Gemini ──
# Clé d'API : https://aistudio.google.com/api-keys?hl=fr
GEMINI_API_KEY='my-gemini-api-key'
GEMINI_MODEL=gemini-2.0-flash
###< ai-provider ###

###> telegram ###
# Ne placez les vraies valeurs que dans .env.local (ignoré par Git).
# Créer un bot via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Récupérer l'ID de votre chat via @userinfobot ou l'API Telegram
TELEGRAM_CHAT_ID=123456789
###< telegram ###

###> rss-feeds ###
# Flux RSS d'offres d'emploi — ajouter autant que nécessaire
# Reddit bloque parfois son flux public avec HTTP 403/429 : réactivez-le si accessible.
# JOB_FEED_URL_1=https://www.reddit.com/r/forhire/.rss
# JOB_FEED_URL_2=https://weworkremotely.com/categories/remote-programming-jobs.rss
###< rss-feeds ###

###> remoteok ###
REMOTEOK_API_URL=https://remoteok.com/api
###< remoteok ###

###> email-alerts ###
# Alertes email des plateformes (LinkedIn, Indeed, HelloWork, Apec, France Travail, WTTJ).
# Utilisez une boîte DÉDIÉE aux alertes et, de préférence, un mot de passe d'application.
# Ne placez les vraies valeurs que dans .env.local (ignoré par Git). Voir docs/EMAIL.md.
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
#EMAIL_IMAP_PORT=993
#EMAIL_IMAP_ENCRYPTION=ssl
EMAIL_IMAP_USERNAME=
# Mot de passe d'application, ou jeton d'accès OAuth2 si EMAIL_IMAP_AUTH=oauth (non renouvelé par Jobscan).
EMAIL_IMAP_PASSWORD=
#EMAIL_IMAP_AUTH=plain
#EMAIL_IMAP_FOLDER=INBOX
#EMAIL_IMAP_VALIDATE_CERT=true
# Parser générique (opt-in) : expéditeurs à traiter et domaines des liens d'offres à retenir.
#EMAIL_GENERIC_SENDER_DOMAINS=
#EMAIL_GENERIC_LINK_DOMAINS=
###< email-alerts ###

###> ats ###
# Job boards d'entreprises sur Greenhouse, Lever et Ashby : API publiques, sans clé.
# Format : `identifiant` ou `identifiant=Nom de l'entreprise`, séparés par des virgules. Entre guillemets si
# espaces. Le nom d'entreprise n'est jamais déduit de l'identifiant : renseignez-le pour qu'il soit connu.
# Liste vide = provider désactivé. Voir docs/PROVIDERS.md pour trouver l'identifiant d'une entreprise.
#GREENHOUSE_BOARDS="exemple=Exemple SAS,demo"
#LEVER_BOARDS="exemple=Exemple SAS"
# Lever : `global` (défaut) ou `eu` selon la région de l'entreprise.
#LEVER_REGION=global
#ASHBY_BOARDS="Exemple=Exemple SAS"
###< ats ###

###> france-travail ###
# API « Offres d'emploi » de France Travail — DÉSACTIVÉE par défaut et NON VALIDÉE contre la
# documentation officielle (voir docs/PROVIDERS.md). Accès restreint : demande sur francetravail.io.
# Ne placez les vrais identifiants que dans .env.local (ignoré par Git).
FRANCE_TRAVAIL_ENABLED=false
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Une requête par mot-clé et par département ; vide = recherche non filtrée.
FRANCE_TRAVAIL_KEYWORDS="php,symfony"
FRANCE_TRAVAIL_DEPARTMENTS=
# Valeurs par défaut à confirmer avec la documentation :
#FRANCE_TRAVAIL_SCOPE="api_offresdemploiv2 o2dsoffre"
#FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token
#FRANCE_TRAVAIL_API_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
###< france-travail ###

###> candidate-profile ###
# Dossier des fichiers locaux du profil candidat (candidate.yaml, search_profiles.yaml) : données
# personnelles, jamais versionnées. Défaut : config/profile/local. Voir docs/PROFILE.md.
#JOBSCAN_PROFILE_DIR=
###< candidate-profile ###

###> jobscan-profile ###
# Profil métier — listes séparées par des virgules, sans espace après la virgule.
# Adapter à un autre profil technique (ex : Python/Django) sans toucher au code.
FILTER_KEYWORDS=php,symfony,wordpress,backend,fullstack,api
KNOWN_STACK=php,symfony,wordpress,mysql,postgresql,redis,docker,react,vue,api,rabbitmq,laravel,typescript,javascript
SEARX_QUERIES="php symfony remote job,php symfony freelance remote,wordpress php remote developer,backend php api remote job,développeur php,développeur php symfony full remote,développeur php WordPress,mission developeur php,mission freelance php symfony remote"
JOB_LOCATIONS="Marseille,Paris,Aix-en-Provence,Ile-de-France,Bouches-du-Rhône,Provence-Alpes-Côte d'Azur,Remote"

# Restriction de COLLECTE : domaines que SearXNG et les flux RSS ne doivent pas récupérer
# (plateformes interdisant l'extraction automatisée). Accepte les sous-domaines.
COLLECTION_BLOCKED_DOMAINS=linkedin.com,indeed.com

# Exclusion MÉTIER : offres écartées quelle que soit leur provenance (alertes email comprises).
# Exemple : EXCLUDED_PLATFORM_DOMAINS=example-spam-board.com
EXCLUDED_PLATFORM_DOMAINS=
###< jobscan-profile ###
