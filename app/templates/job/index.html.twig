{% extends 'base.html.twig' %}

{% block title %}Offres{% endblock %}

{# Badge dynamique dans la sidebar #}
{% block sidebar_job_badge %}
    {% if totalJobs > 0 %}
        <span class="sidebar__item-badge">{{ totalJobs }}</span>
    {% endif %}
{% endblock %}

{% block body %}
    <div class="content-wrapper">

        {# En-tête de page #}
        <div class="page-header">
            <div class="page-header__eyebrow">Veille intelligente</div>
            <h1 class="page-header__title">Offres d'emploi</h1>
            <p class="page-header__subtitle">
                {{ totalJobs }} offre{{ totalJobs > 1 ? 's' : '' }} {{ filterParams is not empty ? 'correspondant aux filtres, ' : '' }}analysée{{ totalJobs > 1 ? 's' : '' }} et
                scorée{{ totalJobs > 1 ? 's' : '' }} par IA
            </p>
        </div>

        {# Filtres #}
        <form class="filter-bar" method="get" action="{{ path('app_job') }}" aria-label="Filtres des offres">
            <div class="filter-fields">
                <label class="filter-field filter-field--location">
                    <span>Localisation</span>
                    <input class="filter-input" type="search" name="location" value="{{ filters.location }}" placeholder="Ex. Paris, France" autocomplete="off">
                </label>
                <label class="filter-field">
                    <span>Télétravail</span>
                    <select class="select" name="remote">
                        <option value="">Toutes</option>
                        <option value="remote" {{ filters.remote is same as(true) ? 'selected' }}>Remote</option>
                        <option value="onsite" {{ filters.remote is same as(false) ? 'selected' }}>Sur site</option>
                    </select>
                </label>
                <label class="filter-field">
                    <span>Contrat</span>
                    <select class="select" name="contract">
                        <option value="">Tous</option>
                        <option value="cdi" {{ filters.contractType and filters.contractType.value == 'cdi' ? 'selected' }}>CDI</option>
                        <option value="freelance" {{ filters.contractType and filters.contractType.value == 'freelance' ? 'selected' }}>Freelance</option>
                    </select>
                </label>
                <label class="filter-field">
                    <span>Séniorité</span>
                    <select class="select" name="seniority">
                        <option value="">Tous</option>
                        <option value="junior" {{ filters.seniority and filters.seniority.value == 'junior' ? 'selected' }}>Junior</option>
                        <option value="mid" {{ filters.seniority and filters.seniority.value == 'mid' ? 'selected' }}>Confirmé</option>
                        <option value="senior" {{ filters.seniority and filters.seniority.value == 'senior' ? 'selected' }}>Senior</option>
                    </select>
                </label>
                <label class="filter-field">
                    <span>Freelance</span>
                    <select class="select" name="freelance">
                        <option value="">Tous</option>
                        <option value="yes" {{ filters.freelance is same as(true) ? 'selected' }}>Oui</option>
                        <option value="no" {{ filters.freelance is same as(false) ? 'selected' }}>Non</option>
                    </select>
                </label>
                <label class="filter-field">
                    <span>Score minimum</span>
                    <input class="filter-input filter-input--score" type="number" name="min_score" min="0" max="100" value="{{ filters.minimumScore }}" placeholder="0">
                </label>
                <label class="filter-field">
                    <span>Source</span>
                    <select class="select" name="source">
                        <option value="">Toutes</option>
                        {% for source in sources %}
                            <option value="{{ source }}" {{ filters.source == source ? 'selected' }}>{{ source }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="filter-field">
                    <span>Ajoutée depuis</span>
                    <select class="select" name="age">
                        <option value="">Toutes dates</option>
                        <option value="1" {{ filters.ageInDays == 1 ? 'selected' }}>24 heures</option>
                        <option value="7" {{ filters.ageInDays == 7 ? 'selected' }}>7 jours</option>
                        <option value="30" {{ filters.ageInDays == 30 ? 'selected' }}>30 jours</option>
                    </select>
                </label>
                <label class="filter-field">
                    <span>Notification</span>
                    <select class="select" name="notified">
                        <option value="">Toutes</option>
                        <option value="no" {{ filters.notified is same as(false) ? 'selected' }}>Non notifiée</option>
                        <option value="yes" {{ filters.notified is same as(true) ? 'selected' }}>Notifiée</option>
                    </select>
                </label>
                <label class="filter-field">
                    <span>Trier par</span>
                    <select class="select" name="sort">
                        <option value="date" {{ filters.sort == 'date' ? 'selected' }}>Date d'ajout</option>
                        <option value="score" {{ filters.sort == 'score' ? 'selected' }}>Score</option>
                    </select>
                </label>
            </div>
            <div class="filter-actions">
                <button class="btn btn--primary btn--sm" type="submit">Appliquer</button>
                {% if filterParams is not empty %}
                    <a class="btn btn--ghost btn--sm" href="{{ path('app_job') }}">Réinitialiser</a>
                {% endif %}
            </div>
        </form>

        {# Grille des offres #}
        {% if jobs is not empty %}

            <div class="jobs-grid" role="list" aria-label="Offres d'emploi">

                {% for job in jobs %}

                    {# Calcul de la classe de score #}
                    {% if job.score >= 75 %}
                        {% set scoreClass = 'excellent' %}
                    {% elseif job.score >= 50 %}
                        {% set scoreClass = 'medium' %}
                    {% else %}
                        {% set scoreClass = 'low' %}
                    {% endif %}

                    {# Ring SVG : r=18, cx=cy=22 → circumference ≈ 113.1 #}
                    {% set dashoffset = 113.1 * (1 - job.score / 100) %}

                    {# Offre créée aujourd'hui ? #}
                    {% set isNew = (job.createdAt|date('Y-m-d') == 'now'|date('Y-m-d')) %}

                    <article class="job-card job-card--{{ scoreClass }}" role="article">

                        {# En-tête : score + titre + méta #}
                        <header class="job-card__header">

                            {# Score ring — SVG conservé : pas d'équivalent FA pour un anneau de progression #}
                            <div class="score-ring" aria-label="Score de pertinence : {{ job.score }}/100">
                                <svg class="score-ring__svg" viewBox="0 0 44 44" aria-hidden="true">
                                    <circle class="score-ring__track" cx="22" cy="22" r="18" />
                                    <circle
                                        class="score-ring__fill score-ring__fill--{{ scoreClass }}"
                                        cx="22"
                                        cy="22"
                                        r="18"
                                        stroke-dasharray="113.1"
                                        stroke-dashoffset="{{ dashoffset|round(2) }}"
                                    />
                                </svg>
                                <div class="score-ring__label">
                                    <span class="score-ring__value">{{ job.score }}</span>
                                </div>
                            </div>

                            {# Titre + méta #}
                            <div class="job-card__title-block">
                                <h2 class="job-card__title">
                                    <a href="{{ job.url }}"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="{{ job.title }}">
                                        {{ job.title }}
                                    </a>
                                </h2>
                                <div class="job-card__meta">
                                    <span class="job-card__source">{{ job.source }}</span>
                                    {% if job.company %}
                                        <span class="job-card__sep" aria-hidden="true"></span>
                                        <span>{{ job.company }}</span>
                                    {% endif %}
                                    {% if job.location %}
                                        <span class="job-card__sep" aria-hidden="true"></span>
                                        <span>{{ job.location }}</span>
                                    {% endif %}
                                    {% if job.createdAt %}
                                        <span class="job-card__sep" aria-hidden="true"></span>
                                        <time class="job-card__date" datetime="{{ job.createdAt|date('c') }}">
                                            {{ job.createdAt|date('d/m/Y · H:i') }}
                                        </time>
                                    {% endif %}
                                    {% if job.notifiedAt %}
                                        <span class="job-card__sep" aria-hidden="true"></span>
                                        <span class="job-card__notified" title="Notifié le {{ job.notifiedAt|date('d/m/Y H:i') }}">
                                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                                            Notifié
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </header>

                        {# Description courte #}
                        <p class="job-card__description">
                            {{- job.description|striptags|slice(0, 240) -}}
                            {{- job.description|striptags|length > 240 ? '…' : '' -}}
                        </p>

                        {# Pied de carte : badges + action #}
                        <footer class="job-card__footer">
                            <div class="job-card__badges">
                                <span class="badge badge--source">{{ job.source }}</span>
                                {% if job.remote %}
                                    <span class="badge badge--remote">Remote</span>
                                {% endif %}
                                {% if job.contractType.value != 'unknown' %}
                                    <span class="badge badge--contract">{{ job.contractType.value|upper }}</span>
                                {% endif %}
                                {% if isNew %}
                                    <span class="badge badge--new">Nouveau</span>
                                {% endif %}
                            </div>
                            <a href="{{ job.url }}"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn--primary btn--sm"
                               aria-label="Voir l'offre {{ job.title }} (nouvel onglet)">
                                Voir l'offre
                                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                            </a>
                        </footer>

                    </article>

                {% endfor %}

            </div>

            {# Pagination #}
            {% if totalPages > 1 %}
                <nav class="pagination" aria-label="Pagination des offres">
                    {% if currentPage > 1 %}
                        <a href="{{ path('app_job', filterParams|merge({ page: currentPage - 1 })) }}"
                           class="btn btn--ghost btn--sm"
                           rel="prev">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                            Précédent
                        </a>
                    {% endif %}

                    <span class="pagination__info">Page {{ currentPage }} sur {{ totalPages }}</span>

                    {% if currentPage < totalPages %}
                        <a href="{{ path('app_job', filterParams|merge({ page: currentPage + 1 })) }}"
                           class="btn btn--ghost btn--sm"
                           rel="next">
                            Suivant
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                </nav>
            {% endif %}

        {% else %}

            {# État vide #}
            <div class="jobs-grid">
                <div class="empty-state" role="status">
                    <i class="fa-solid fa-magnifying-glass-plus empty-state__icon" aria-hidden="true"></i>
                    <h2 class="empty-state__title">Aucune offre ne correspond à ces critères</h2>
                    <p class="empty-state__text">
                        {% if filterParams is not empty %}
                            Modifiez ou réinitialisez les filtres pour élargir la recherche.
                        {% else %}
                            Lancez le pipeline pour commencer à agréger et scorer des offres d'emploi.
                        {% endif %}
                    </p>
                </div>
            </div>

        {% endif %}
    </div>
{% endblock %}
