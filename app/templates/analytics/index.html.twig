{% extends 'base.html.twig' %}

{% block title %}Analytics{% endblock %}

{% macro rate_cell(part, total) %}
    {% set percent = rate_percent(part, total) %}
    <span class="rate">
        <span class="rate__text">{{ part }}/{{ total }}{% if percent is not null %} <strong>{{ percent }} %</strong>{% endif %}</span>
        {% if percent is not null %}<progress class="meter" max="100" value="{{ percent }}" aria-label="{{ percent }} %"></progress>{% endif %}
    </span>
{% endmacro %}

{% block body %}
    {% set f = report.funnel %}
    <div class="content-wrapper">

        <div class="page-header page-header--split">
            <div>
                <div class="page-header__eyebrow">Pilotage</div>
                <h1 class="page-header__title">Analytics</h1>
                <p class="page-header__subtitle">Calculé localement sur vos données. Des comptages, pas des preuves : les offres visées diffèrent d'un CV, d'un canal ou d'une source à l'autre.</p>
            </div>
            <nav class="chips" aria-label="Période">
                {% for key, label in windows %}
                    <a class="chip chip--plain {{ choice == key ? 'chip--active' : '' }}" href="{{ path('app_analytics', {since: key}) }}">{{ label }}</a>
                {% endfor %}
            </nav>
        </div>

        {% if f.sent == 0 %}
            <div class="empty-state">
                <i class="fa-solid fa-chart-column empty-state__icon" aria-hidden="true"></i>
                <div class="empty-state__title">Aucune candidature envoyée sur la période</div>
                <p class="empty-state__text">Les statistiques apparaîtront dès qu'une candidature sera passée à « Postulé ».</p>
            </div>
        {% else %}
            {% set responded = rate_percent(f.responded, f.sent) %}
            <div class="stats-grid stats-grid--auto">
                <div class="stat-card">
                    <div class="stat-card__header"><span class="stat-card__label">Envoyées</span><span class="stat-card__icon stat-card__icon--primary"><i class="fa-solid fa-paper-plane"></i></span></div>
                    <div class="stat-card__value">{{ f.sent }}</div>
                    <div class="stat-card__meta">candidatures sur la période</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__header"><span class="stat-card__label">Réponses</span><span class="stat-card__icon stat-card__icon--success"><i class="fa-solid fa-reply"></i></span></div>
                    <div class="stat-card__value">{{ f.responded }}{% if responded is not null %}<small>{{ responded }} %</small>{% endif %}</div>
                    <div class="stat-card__meta">entretien, test, proposition ou refus</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__header"><span class="stat-card__label">Entretiens ou tests</span><span class="stat-card__icon stat-card__icon--secondary"><i class="fa-solid fa-user-group"></i></span></div>
                    <div class="stat-card__value">{{ f.interviews }}</div>
                    <div class="stat-card__meta">atteints, d'après l'historique</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__header"><span class="stat-card__label">Propositions</span><span class="stat-card__icon stat-card__icon--warning"><i class="fa-solid fa-handshake"></i></span></div>
                    <div class="stat-card__value">{{ f.offers }}</div>
                    <div class="stat-card__meta">{{ f.accepted }} acceptée{{ f.accepted > 1 ? 's' : '' }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__header"><span class="stat-card__label">Première réponse</span><span class="stat-card__icon stat-card__icon--primary"><i class="fa-regular fa-clock"></i></span></div>
                    <div class="stat-card__value">{{ f.medianDaysToResponse is null ? '—' : f.medianDaysToResponse|number_format(1, ',') }}{% if f.medianDaysToResponse is not null %}<small>jours</small>{% endif %}</div>
                    <div class="stat-card__meta">délai médian après l'envoi</div>
                </div>
            </div>

            <div class="panel">
                <div class="panel__header">
                    <h2 class="panel__title">Situation actuelle</h2>
                    <span class="panel__hint">statut actuel des candidatures envoyées</span>
                </div>
                <div class="panel__body status-summary">
                    <span class="status-pill status-pill--accepted">{{ f.accepted }} acceptée{{ f.accepted > 1 ? 's' : '' }}</span>
                    <span class="status-pill status-pill--rejected">{{ f.rejected }} refusée{{ f.rejected > 1 ? 's' : '' }}</span>
                    <span class="status-pill status-pill--no_response">{{ f.noResponse }} sans réponse</span>
                </div>
            </div>

            {% for dimension, title in titles %}
                {% set rows = report.breakdowns[dimension] %}
                {% if rows is not empty %}
                    <section class="panel">
                        <div class="panel__header"><h2 class="panel__title">{{ title }}</h2></div>
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead><tr><th></th><th class="num">Envoyées</th><th class="num">Réponses</th><th class="num">Entretiens</th><th class="num">Propositions</th></tr></thead>
                                <tbody>
                                    {% for row in rows %}
                                        <tr>
                                            <td><span class="cell-link">{{ row.label }}</span></td>
                                            <td class="num">{{ row.sent }}</td>
                                            <td class="num">{{ _self.rate_cell(row.responded, row.sent) }}</td>
                                            <td class="num">{{ _self.rate_cell(row.interviews, row.sent) }}</td>
                                            <td class="num">{{ _self.rate_cell(row.offers, row.sent) }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>
                {% endif %}
            {% endfor %}
        {% endif %}

        <section class="panel">
            <div class="panel__header">
                <h2 class="panel__title">Rendement des sources</h2>
                <span class="panel__hint">offres collectées, hors doublons</span>
            </div>
            {% if report.sourcing is empty %}
                <div class="panel__body"><p class="panel__hint">Aucune offre collectée sur la période.</p></div>
            {% else %}
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Source</th><th class="num">Collectées</th><th class="num">Compatibles</th><th class="num">Notifiées</th><th class="num">Suivies</th><th class="num">Postulées</th></tr></thead>
                        <tbody>
                            {% for row in report.sourcing %}
                                <tr>
                                    <td><span class="cell-link">{{ row.source }}</span></td>
                                    <td class="num">{{ row.collected }}</td>
                                    <td class="num">{{ _self.rate_cell(row.compatible, row.collected) }}</td>
                                    <td class="num">{{ row.notified }}</td>
                                    <td class="num">{{ row.tracked }}</td>
                                    <td class="num">{{ row.applied }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            <div class="panel__footnote">Un pourcentage n'apparaît qu'à partir de {{ constant('App\\Analytics\\Rate::MIN_SAMPLE') }} éléments : en dessous, seul le décompte est affiché.</div>
        </section>
    </div>
{% endblock %}
