{% extends 'base.html.twig' %}

{% block title %}Candidatures{% endblock %}

{% block body %}
    <div class="content-wrapper">

        <div class="page-header">
            <div class="page-header__eyebrow">Suivi</div>
            <h1 class="page-header__title">Candidatures</h1>
            <p class="page-header__subtitle">Ce que vous avez déclaré : Jobscan n'envoie jamais rien à un recruteur.</p>
        </div>

        {% if dueCount > 0 %}
            <div class="callout" role="status">
                <span class="callout__icon" aria-hidden="true">⏰</span>
                <span>{{ dueCount }} relance{{ dueCount > 1 ? 's' : '' }} à faire : la date prévue est atteinte.</span>
            </div>
        {% endif %}

        <nav class="chips" aria-label="Filtrer par statut">
            <a class="chip chip--plain {{ filter is null ? 'chip--active' : '' }}" href="{{ path('app_applications') }}">Toutes</a>
            {% for status in statuses %}
                {% if counts[status.value] is defined %}
                    <a class="chip {{ filter == status ? 'chip--active' : '' }}" href="{{ path('app_applications', {status: status.value}) }}">
                        {{ status.label }} <span class="chip__count">{{ counts[status.value] }}</span>
                    </a>
                {% endif %}
            {% endfor %}
        </nav>

        {% if applications is empty %}
            <div class="empty-state">
                <i class="fa-regular fa-paper-plane empty-state__icon" aria-hidden="true"></i>
                <div class="empty-state__title">Aucune candidature</div>
                <p class="empty-state__text">Ouvrez-en une depuis la liste des offres avec « Suivre ».</p>
            </div>
        {% else %}
            <div class="panel">
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr><th>Poste</th><th>Statut</th><th>Postulé le</th><th>Relance</th><th>CV</th></tr>
                        </thead>
                        <tbody>
                            {% for application in applications %}
                                <tr>
                                    <td>
                                        <a class="cell-link" href="{{ path('app_application_show', {id: application.id}) }}">{{ application.job.title }}</a>
                                        <span class="cell-sub">{{ application.job.company ?? 'Entreprise non précisée' }}{% if application.job.location %} · {{ application.job.location }}{% endif %}</span>
                                    </td>
                                    <td><span class="status-pill status-pill--{{ application.status.value }}">{{ application.status.label }}</span></td>
                                    <td>{{ application.appliedAt ? application.appliedAt|date('d/m/Y') : '—' }}</td>
                                    <td>
                                        {% if application.followUpAt %}
                                            {{ application.followUpAt|date('d/m/Y') }}
                                            {% if application.followUpDue(now) %}<span class="tag-due" title="Relance due">⏰ à faire</span>{% endif %}
                                        {% else %}<span class="muted">—</span>{% endif %}
                                    </td>
                                    <td>{{ application.cvVersionLabel ?? '—' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
